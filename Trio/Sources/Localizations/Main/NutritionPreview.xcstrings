{
  "sourceLanguage": "en",
  "strings": {
    "Health data is unavailable. Unlock the phone and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Health data is unavailable. Unlock the phone and try again.",
            "state": "translated"
          }
        }
      }
    },
    "Select the Cronometer source. Trio’s own exports cannot be selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Select the Cronometer source. Trio’s own exports cannot be selected.",
            "state": "translated"
          }
        }
      }
    },
    "The returned records contain duplicate identifiers or invalid dates. No preview was accepted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "The returned records contain duplicate identifiers or invalid dates. No preview was accepted.",
            "state": "translated"
          }
        }
      }
    },
    "Too many nutrition records were returned. The preview was not truncated.": {
      "localizations": {
