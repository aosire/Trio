            "state": "translated"
          }
        }
      }
    },
    "Correction defaults to zero and changes only this preview. Negative values move sample times earlier. Date Added to Health is not exposed by the public HealthKit sample API. Refresh time is not meal time. Records cover sample dates from 48 hours ago through 24 hours ahead; all times below use the phone’s time zone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Correction defaults to zero and changes only this preview. Negative values move sample times earlier. Date Added to Health is not exposed by the public HealthKit sample API. Refresh time is not meal time. Records cover sample dates from 48 hours ago through 24 hours ahead; all times below use the phone’s time zone.",
            "state": "translated"
          }
        }
      }
    },
