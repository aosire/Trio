    },
    "No preview records. Empty results can also mean read access was denied, not synced, or dates are outside the sample-time window. HealthKit does not disclose whether read permission was denied.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "No preview records. Empty results can also mean read access was denied, not synced, or dates are outside the sample-time window. HealthKit does not disclose whether read permission was denied.",
            "state": "translated"
          }
        }
      }
    },
    "Only the selected source is read. Trio’s own source is excluded. Your existing Apple Health export setting is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Only the selected source is read. Trio’s own source is excluded. Your existing Apple Health export setting is unchanged.",
