      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Cronometer Health preview",
            "state": "translated"
          }
        }
      }
    },
    "Read-only preview. Nothing here is logged in Trio, converted to FPUs or used for insulin decisions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Read-only preview. Nothing here is logged in Trio, converted to FPUs or used for insulin decisions.",
            "state": "translated"
          }
        }
      }
    },
    "Check the source, quantities and times against Cronometer. Matching timestamps are grouped together; this does not prove they are one meal. Missing nutrients remain unknown, never zero.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "value": "Check the source, quantities and times against Cronometer. Matching timestamps are grouped together; this does not prove they are one meal. Missing nutrients remain unknown, never zero.",
